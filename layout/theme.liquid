<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#ecebe8">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Michroma&family=Shippori+Mincho+B1:wght@600;800&display=swap">
    {{ 'kurovani.css' | asset_url | stylesheet_tag }}
    <style>body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
    {{ content_for_header }}
  </head>
  <body class="template-{{ template.name }}">
    {% section 'header' %}
    <main id="main" role="main">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>
      window.KV = {
        root: {{ routes.root_url | json }},
        add: {{ 'products.add_to_cart' | t | json }},
        soldout: {{ 'products.sold_out' | t | json }},
        unavailable: {{ 'products.unavailable' | t | json }},
        pick: {{ 'products.pick_size' | t | json }},
        added: {{ 'cart.added' | t | json }},
        error: {{ 'cart.error' | t | json }}
      };
    </script>
    <script src="{{ 'kurovani.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
