{%- assign current = product.selected_or_first_available_variant -%}
<section class="page">
  <div class="wrap pdp">
    <div class="gallery">
      {% render 'product-shot', product: product, link: false, kanji: product.metafields.custom.kanji.value, main_id: 'pdp-main' %}
      {%- if product.media.size > 1 -%}
        <div class="thumbs" role="group" aria-label="{{ 'products.gallery' | t }}">
          {%- for media in product.media limit: 12 -%}
            <button type="button" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-src="{{ media.preview_image | image_url: width: 1400 }}" aria-label="{{ 'products.image' | t: index: forloop.index }}">
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="info">
      <span class="label">{{ product.type | default: product.vendor }}</span>
      <h1>{{ product.title }}</h1>
      <div class="price" data-price>{% render 'price', item: current %}</div>
      {%- assign has_specs = false -%}
      {%- capture specs -%}
        {%- for tag in product.tags -%}
          {%- if tag contains ':' -%}
            {%- assign has_specs = true -%}
            {%- assign kv = tag | split: ':' -%}
            <div><dt>{{ kv[0] | strip }}</dt><dd>{{ kv[1] | strip }}</dd></div>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if has_specs -%}
        <dl class="specs">{{ specs }}</dl>
      {%- endif -%}
      {%- form 'product', product, data-variants: 'true' -%}
        <input type="hidden" name="id" value="{{ current.id }}">
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="opt" style="margin-bottom:16px">
              <legend>{{ option.name }}</legend>
              {%- for value in option.values -%}
                <label>
                  <input type="radio" name="option-{{ option.position }}" id="o-{{ option.position }}-{{ forloop.index }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                  <span>{{ value }}</span>
                </label>
              {%- endfor -%}
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}
        <script type="application/json">
          [
            {%- for variant in product.variants -%}
              {%- capture price_html -%}{% render 'price', item: variant %}{%- endcapture -%}
              { "id": {{ variant.id }}, "available": {{ variant.available | json }}, "options": {{ variant.options | json }}, "price_html": {{ price_html | strip | json }} }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        </script>
        <button type="submit" class="btn btn-red" style="width:100%;justify-content:center"{% unless current.available %} disabled{% endunless %}>
          {%- if current.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
        </button>
        <div style="margin-top:12px">{{ form | payment_button }}</div>
      {%- endform -%}
      {%- if product.description != blank -%}
        <div class="rte">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>
</section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{ "name": "Fiche produit", "settings": [] }
{% endschema %}
