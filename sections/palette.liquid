<section class="blk" id="marque">
  <div class="wrap">
    <div class="head">
      <div>
        <span class="tab label">{{ section.settings.label }} {% render 'slashes' %}</span>
        <h2>{{ section.settings.title }}</h2>
      </div>
    </div>
    <div class="palette">
      <div class="sw c1"><b>Black</b><span>#000000 · Pantone Black C</span></div>
      <div class="sw c2"><b>Deep Red</b><span>#D1001C · Pantone 199 C</span></div>
      <div class="sw c3"><b>Dark Grey</b><span>#3A3A3A · Cool Gray 11 C</span></div>
      <div class="sw c4"><b>Off-White</b><span>#EAEAEA · Cool Gray 1 C</span></div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Palette",
  "settings": [
    { "type": "text", "id": "label", "label": "Étiquette", "default": "Palette" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Quatre couleurs, pas une de plus" }
  ],
  "presets": [ { "name": "Palette" } ]
}
{% endschema %}
