<section class="hero" style="min-height:100vh;display:grid;align-items:center">
  <div class="wrap" style="display:block;text-align:left;max-width:720px">
    <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="232" height="96" style="mix-blend-mode:screen;margin-bottom:24px">
    <h1>{{ 'password.title' | t }}</h1>
    {%- if shop.password_message != blank -%}<p style="margin:16px 0">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <div class="field" style="display:flex;gap:10px;margin-top:24px;max-width:460px">
        <input type="password" name="password" id="store-password" placeholder="{{ 'password.placeholder' | t }}" aria-label="{{ 'password.placeholder' | t }}" autocomplete="current-password">
        <button type="submit" class="btn btn-red" style="height:42px">{{ 'password.enter' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Mot de passe boutique", "settings": [] }
{% endschema %}
