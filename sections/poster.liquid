<section class="blk" id="affiche">
  <div class="wrap poster">
    <div class="frame">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(max-width: 820px) 90vw, 520px' }}
      {%- else -%}
        <img src="{{ 'poster-dos.jpg' | asset_url }}" alt="{{ section.settings.title | escape }}" width="900" height="1200" loading="lazy">
      {%- endif -%}
    </div>
    <div>
      <span class="tab label">{{ section.settings.label }} {% render 'slashes' %}</span>
      <h2>{{ section.settings.title }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Affiche",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Affiche (sinon l'affiche fournie)" },
    { "type": "text", "id": "label", "label": "Étiquette", "default": "Affiche" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Le dos raconte l'histoire" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Première affiche de la collection : un personnage original, de dos, l'ensemble Originals sur les épaules, face au soleil rouge.</p>" }
  ],
  "presets": [ { "name": "Affiche" } ]
}
{% endschema %}
